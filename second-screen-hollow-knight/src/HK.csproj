<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ArmadaSecondScreenHK</AssemblyName>
    <LangVersion>latest</LangVersion>
    <DebugType>none</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS0618;CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../lib/unity/core/*.cs" />
    <Reference Include="Assembly-CSharp"><HintPath>$(Refs)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PlayMaker"><HintPath>$(Refs)/PlayMaker.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Refs)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TeamCherry.Localization"><HintPath>$(Refs)/TeamCherry.Localization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(Refs)/UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Refs)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
